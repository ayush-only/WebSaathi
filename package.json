{
  "name": "websaathi",
  "version": "0.1.0",
  "private": true,
  "description": "WebSaathi — AI web companion for non-technical users (wHACKiest 2026, Track 02: Beyond the Browser)",
  "scripts": {
    "demo": "node apps/demo-portal/server.js",
    "backend": "node apps/backend/src/server.js",
    "check": "node scripts/check.js",
    "lint": "eslint .",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:browser": "node --test --test-concurrency=1 \"tests/browser/*.test.js\"",
    "test:all": "npm run check && npm run lint && npm test && npm run test:browser"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "playwright-core": "^1.65.1"
  }
}
