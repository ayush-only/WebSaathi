# WebSaathi backend configuration. Copy to `.env` (repo root or backend/) and fill in.
# `.env` is git-ignored. These keys live ONLY on the backend — never in the extension.
# Without them the extension still works in Local Demo Mode.

# --- Server ---
PORT=8787
HOST=127.0.0.1
# Set this to your installed ID from chrome://extensions. Separate multiple IDs with commas.
ALLOWED_EXTENSION_IDS=

# --- AWS Bedrock (Live AI mode) ---
AWS_REGION=us-east-1
# Any Bedrock chat model (or inference profile) you have access to that supports the Converse API.
# Example placeholder — check the Bedrock console for the exact ID available in your account/region.
BEDROCK_MODEL_ID=
# Credentials: use the standard AWS chain (AWS_PROFILE, or the two keys below, or an instance role).
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Alternatively a Bedrock API key:
AWS_BEARER_TOKEN_BEDROCK=

# --- ElevenLabs (spoken guidance) ---
ELEVENLABS_API_KEY=
# Voice ID from your ElevenLabs voice library
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
